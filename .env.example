# ---------------------------------------------------------------------------
# Backend (Spring Boot)
# Local development needs NONE of these: the default "dev" profile has safe local
# defaults (DB on localhost:5433, dev JWT secret, demo data, admin@judoclub.dz / Admin123!).
# Production (SPRING_PROFILES_ACTIVE=prod) has NO defaults: the variables marked
# [prod: required] must be set or the app refuses to start.
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

DATABASE_URL=jdbc:postgresql://localhost:5433/judo_club_constantine   # [prod: required]
DATABASE_USERNAME=judo                                                # [prod: required]
DATABASE_PASSWORD=judo                                                # [prod: required]

# At least 32 bytes; generate with: openssl rand -base64 48              [prod: required]
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440
JWT_COOKIE_NAME=jcc_token
# true in prod (HTTPS). The prod profile refuses to start with false.
JWT_SECURE_COOKIE=false

# Comma-separated. Empty = no CORS (prod is same-origin behind Caddy).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# First administrator: created at startup only if NO admin exists yet.
# After the first login you can remove ADMIN_PASSWORD from the environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Brute-force protection on /api/auth/login and /register (then HTTP 429 + Retry-After).
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_EMAIL_MAX_FAILURES=15
LOGIN_RATE_LIMIT_WINDOW=10m

# Public sign-up (POST /api/auth/register). Off by default: visitors need no account.
REGISTRATION_ENABLED=false

# Demo event/athletes/user (dev profile only; ignored in prod).
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# Show the "S'inscrire" tab on /login. Must match the backend's REGISTRATION_ENABLED.
NEXT_PUBLIC_REGISTRATION_ENABLED=false
